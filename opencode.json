{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "zai-coding-plan": {
      "models": {
        "glm-5.2": {
          "options": { "reasoningEffort": "high" },
          "limit": {
            "context": 250000,
            "output": 50000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "threshold": 0.75,
    "maxContext": 95000
  }
}
